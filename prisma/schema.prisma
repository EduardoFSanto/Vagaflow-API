generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  
}

// ============================================
// 1. USER - Tabela de Autenticação
// ============================================
// POR QUÊ: Unifica auth de candidatos e empresas
// Um único lugar pra login, email único no sistema

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role
  
  // Relações (só 1 pode existir!)
  company   Company?
  candidate Candidate?
  
  // Auditoria (quando foi criado/atualizado)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users") // Nome da tabela no PostgreSQL
}

enum Role {
  CANDIDATE // Candidato buscando vaga
  COMPANY   // Empresa oferecendo vaga
}

// ============================================
// 2. COMPANY - Dados da Empresa
// ============================================
// POR QUÊ: Separado de User porque nem todo User é Company
// Só existe se role = COMPANY

model Company {
  id     String @id @default(uuid())
  userId String @unique // 1 User = 1 Company
  
  // Relação com User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // onDelete: Cascade = Se deletar User, deleta Company também
  
  // Dados básicos da empresa
  name        String
  description String?
  cnpj        String?  @unique
  website     String?
  logo        String?  // URL da logo
  phone       String?
  
  // Dados de localização
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  
  // Dados profissionais
  industry    String?      // "Tecnologia", "Financeiro", etc.
  companySize String?      // "1-50", "51-200", "201-500", "500+"
  foundedYear Int?
  linkedinUrl String?
  
  // Relação: 1 Company tem N Jobs
  jobs Job[]
  
  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("companies")
}

// ============================================
// 3. CANDIDATE - Dados do Candidato
// ============================================
// POR QUÊ: Separado de User porque nem todo User é Candidate
// Só existe se role = CANDIDATE

model Candidate {
  id     String @id @default(uuid())
  userId String @unique // 1 User = 1 Candidate
  
  // Relação com User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // onDelete: Cascade = Se deletar User, deleta Candidate também
  
  // Dados pessoais
  name        String
  phone       String?
  dateOfBirth DateTime?
  
  // Dados de localização
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  
  // Dados profissionais
  bio         String?      // Resumo profissional
  title       String?      // Título profissional atual (ex: "Senior Developer")
  skills      String[]     // ["JavaScript", "React", "Node.js"]
  experience  Int?         // Anos de experiência
  resumeUrl   String?      // URL do currículo PDF
  portfolioUrl String?     // URL do portfólio
  
  // Educação
  education    String?       // Ex: "Bacharelado em Ciência da Computação"
  university   String?       // Nome da universidade
  graduationYear Int?
  certifications String[]    // ["AWS Certified", "Google Cloud Certified"]
  
  // Dados adicionais
  languages   String[]       // ["Português", "Inglês", "Espanhol"]
  availability String @default("IMMEDIATE") // IMMEDIATE, 30_DAYS, 60_DAYS, NEGOTIABLE
  employmentType String[]    // ["CLT", "PJ", "Autônomo"]
  linkedinUrl String?
  githubUrl   String?
  
  // Dados de candidatura
  expectedSalary Float?
  salaryExpected String?     // "40k-60k", "60k-80k", etc.
  
  // Relação: 1 Candidate tem N Applications
  applications Application[]
  
  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("candidates")
}

// ============================================
// 4. JOB - Vaga de Emprego
// ============================================
// POR QUÊ: Company oferece vagas
// Candidate se candidata pra vagas

model Job {
  id        String @id @default(uuid())
  companyId String
  
  // Relação: N Jobs pertencem a 1 Company
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // onDelete: Cascade = Se deletar Company, deleta todas Jobs dela
  
  // Dados básicos da vaga
  title       String
  description String
  salary      Float?   // Salário (opcional)
  salaryMin   Float?   // Salário mínimo
  salaryMax   Float?   // Salário máximo
  location    String   // "São Paulo, SP" ou "Remoto"
  remote      Boolean  @default(false)
  type        String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT
  
  // Requisitos
  requiredSkills String[] // ["JavaScript", "React"]
  requiredExperience Int? // Anos de experiência mínima
  educationLevel String? // "Ensino Médio", "Graduação", "Pós-graduação"
  
  // Informações adicionais
  department  String?  // Departamento
  benefits    String[] // ["Healthcare", "Flexible Hours", "Work from Home"]
  schedule    String?  // Horário
  languages   String[] // Idiomas necessários
  
  // Status da vaga
  status JobStatus @default(OPEN)
  
  // Auditoria
  views       Int @default(0) // Quantidade de visualizações
  appliedCount Int @default(0) // Quantidade de candidatos
  
  // Relação: 1 Job tem N Applications
  applications Application[]
  questions    JobQuestion[]
  
  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("jobs")
}

enum JobStatus {
  OPEN   // Vaga aberta (aceitando candidatos)
  CLOSED // Vaga fechada (contrataram alguém)
  PAUSED // Vaga pausada (temporariamente sem aceitar)
}

// ============================================
// 5. APPLICATION - Candidatura
// ============================================
// POR QUÊ: Conecta Candidate com Job
// Registra quando candidato se candidata

model Application {
  id          String @id @default(uuid())
  candidateId String
  jobId       String
  
  // Relações
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // onDelete: Cascade = Se deletar Candidate ou Job, deleta Application
  
  // Dados da candidatura
  coverLetter    String?  // Carta de apresentação
  salaryExpected Float?   // Pretensão salarial
  startDate      DateTime? // Data que pode começar
  availability   String?  // "Immediate", "2 weeks", "1 month"
  
  // Informações adicionais
  yearsExperience Int?    // Anos de experiência que o candidato indicou
  matchScore     Int?     // Score de match (0-100) - calculado automaticamente
  notes          String?  // Notas internas da empresa
  
  // Status
  status ApplicationStatus @default(PENDING)

  // Respostas das perguntas da vaga
  answers ApplicationAnswer[]
  
  // Histórico
  reviewedAt DateTime?
  reviewedBy String?     // ID do usuário que revisou
  rejectionReason String? // Motivo da rejeição
  
  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // IMPORTANTE: Candidato não pode aplicar 2x pra mesma vaga!
  @@unique([candidateId, jobId])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING   // Aguardando análise
  REVIEWING // Em análise
  APPROVED  // Aprovado (vai pra entrevista)
  REJECTED  // Rejeitado
  HIRED     // Contratado!
}

model JobQuestion {
  id        String @id @default(uuid())
  jobId     String
  prompt    String
  type      JobQuestionType @default(SHORT_TEXT)
  required  Boolean @default(false)
  order     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers ApplicationAnswer[]

  @@map("job_questions")
}

enum JobQuestionType {
  SHORT_TEXT
  LONG_TEXT
}

model ApplicationAnswer {
  id            String @id @default(uuid())
  applicationId String
  questionId    String
  answer        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@map("application_answers")
}

